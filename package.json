{
  "name": "multichat",
  "version": "1.0.0",
  "description": "Twitch + YouTube chat overlay",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "dependencies": {
    "@twurple/auth": "^7.1.0",
"@twurple/api": "^7.1.0",
"@twurple/eventsub-ws": "^7.1.0",
    "dotenv": "^16.6.1",
    "tmi.js": "^1.8.5",
    "youtube-chat-next": "^3.1.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.example.multichat",
    "productName": "Multichat",
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "package.json",
      "node_modules/**/*",
      ".env",
      "tokens.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "oneClick": false
    }
  }
}
